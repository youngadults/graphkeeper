# Connection string for the Postgres (Neon) database that stores the graph.
#
# OPTIONAL for local development: when unset, GraphKeeper runs entirely
# in-memory with a pre-seeded demo graph (data resets on every server restart).
#
# When set (locally or on Vercel), all data lives in Postgres via the Neon
# serverless driver. Use the pooled connection string from your Neon dashboard.
#   Neon -> Project -> Dashboard -> Connection string (pooled)
POSTGRES_URL="postgresql://user:password@ep-cool-name-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"